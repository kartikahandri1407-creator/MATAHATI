# Salin menjadi .env (lokal) atau isi di Settings > Environment Variables (Vercel) / Secrets (AI Studio).
# JANGAN pernah memasukkan nilai asli ke kode atau GitHub.

# Wajib untuk analisis AI. Tanpa ini aplikasi memakai mesin aturan lokal.
GEMINI_API_KEY=

# Opsional: aktifkan database. Tanpa ini data disimpan di browser.
# Firebase: isi dengan JSON service account (satu baris) atau versi base64-nya.
FIREBASE_SERVICE_ACCOUNT=
# Atau Supabase:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Opsional
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
